# Pengembangan lokal (`npm run dev`). Di VPS nilai-nilai ini diisi
# deploy/docker-compose.yml dari deploy/.env — lihat deploy/README.md.
#
# Postgres + PostgREST lokal:
#   cd deploy && docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db rest

# Login skema auth (role imr_auth). Kata sandinya = IMR_AUTH_PASSWORD di deploy/.env.
AUTH_DATABASE_URL="postgres://imr_auth:<IMR_AUTH_PASSWORD>@127.0.0.1:5432/imr"

# PostgREST, TANPA /rest/v1. Seluruh query berjalan di server dengan JWT
# pengguna, dan RLS yang memutuskan hasilnya.
DATA_API_URL="http://127.0.0.1:3001"

# Sama persis dengan JWT_SECRET di deploy/.env — PostgREST memverifikasi
# setiap JWT yang ditandatangani aplikasi dengan kunci ini. Minimal 32 karakter.
JWT_SECRET=""

# Lampiran di disk lokal. Kosongkan dan isi AWS_* di bawah untuk memakai
# bucket S3-compatible sebagai gantinya.
STORAGE_DIR=".berkas"
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=

# Token integrasi sistem operasional ILJ (Laravel).
#
# Nilainya harus sama persis dengan INTEGRASI_TOKEN di .env sistem
# operasional; keduanya dibandingkan dengan hash_equals di sisi sana.
#
# Kosong berarti tombol "Tarik data operasional" menolak bekerja dengan
# pesan yang jelas — bukan memanggil endpoint tanpa token.
OPERATIONAL_SYNC_TOKEN=""

# Brevo (email transaksional) untuk tautan "Lupa kata sandi". Server-only.
# BREVO_SENDER_EMAIL harus sender yang sudah diverifikasi di Brevo.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Portal Keuangan"

# --- Tes (npm test) tetap memakai stack Supabase lokal (`supabase start`) ---
PUBLIC_SUPABASE_URL="http://127.0.0.1:55321"
PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
