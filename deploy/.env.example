# Salin ke deploy/.env di VPS lalu isi. File itu TIDAK pernah di-commit.
#
# Buat setiap rahasia dengan:  openssl rand -hex 32
# (hex, supaya aman ditaruh di URL koneksi Postgres tanpa di-escape.)

# Domain portal; DNS A record-nya sudah mengarah ke IP VPS.
DOMAIN=portal.contoh.co.id
# Email untuk Let's Encrypt (pemberitahuan sertifikat).
ACME_EMAIL=admin@contoh.co.id

# Superuser Postgres. Dipakai migrasi dan backup saja, tidak oleh aplikasi.
POSTGRES_PASSWORD=
# Login PostgREST (role authenticator).
AUTHENTICATOR_PASSWORD=
# Login aplikasi untuk skema auth (role imr_auth).
IMR_AUTH_PASSWORD=
# Kunci tanda tangan JWT antara app dan PostgREST, juga tautan lampiran.
# Minimal 32 karakter. Mengubahnya mengeluarkan semua tautan lampiran yang
# sedang terbuka, tetapi tidak sesi login.
JWT_SECRET=

# Postgres — untuk VPS 2 GB. Naikkan bila RAM ditambah: 4 GB → 256MB / 1536MB.
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=512MB

# Sistem operasional ILJ (Laravel). Kosong = tombol tarik data menolak.
OPERATIONAL_SYNC_TOKEN=

# Brevo untuk email "Lupa kata sandi". Sender harus terverifikasi di Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Portal Keuangan
